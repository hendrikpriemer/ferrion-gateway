# No build/compile step by design (see README) - every entrypoint runs
# directly via tsx, so this is a single stage that just installs real
# runtime dependencies (tsx and pino-pretty are regular dependencies, not
# devDependencies, for exactly this reason) and copies the source.
# Node 22 (Active LTS): Node 20 has had no security fixes since
# 2026-04-30, and a CRA-covered product cannot ship an EOL runtime. 22
# rather than 24 to match the platform (ferrion: engines >=22.13).
# Only native addon in the production tree is @serialport/bindings-cpp
# (N-API, musl prebuilds), so the major bump is ABI-safe (review 2026-09,
# H-5).
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
# --ignore-scripts: package.json's `prepare` lifecycle script
# (scripts/install-git-hooks.mjs) installs a *local* git pre-commit hook -
# meaningless inside a container with no ongoing git checkout (and
# scripts/ isn't even copied in yet at this point, so it'd fail outright:
# confirmed live, "Cannot find module '/app/scripts/install-git-hooks.mjs'",
# same failure mode already hit and fixed the same way in
# the ferrion platform's own Dockerfile.production). None of this image's
# direct dependencies rely on their own install-time postinstall/preinstall
# scripts (checked each package.json), so skipping lifecycle scripts here
# is safe.
RUN npm ci --omit=dev --ignore-scripts

# The image installs production node_modules above, which makes it a
# redistribution of every package in there - so the terms travel with it.
COPY LICENSE ./
COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src
COPY fleet ./fleet
COPY public ./public

# The NOTICE is generated HERE rather than copied in, because the two are
# not the same list. Some dependencies ship one binary package per platform,
# so a NOTICE generated on a developer's machine names that machine's
# variant - measured: an image built on this Mac contained
# @esbuild/linux-arm64 while the copied-in NOTICE named @esbuild/darwin-arm64.
# It listed a package that was not present and omitted one that was.
#
# Generated against the tree `npm ci` just installed, the file is correct for
# the artifact it ships inside, by construction. The repo keeps its own copy
# for source recipients; it is regenerated by hand with `npm run notice` after
# every dependency change (`--check` is a local check, not a CI one - see
# scripts/generate-notice.ts for why). It once lagged a month behind.
RUN npx tsx scripts/generate-notice.ts

# data/ holds the control-plane's instance/settings JSON stores plus each
# running instance's persisted reading buffer (reading-buffers/, see
# gateway/reading-buffer-store.ts) - mount a volume here to persist them
# across container restarts (see docker-compose.yml). Without that mount, a
# container recreate (not just a process restart inside the same container)
# still loses whatever was buffered.
RUN mkdir -p data

# Web UI port + the default first-instance port for each simulated
# protocol (see fleet/port-allocator.ts's BASE_PORTS) - additional
# concurrent instances of the same protocol use the next port up, hence
# docker-compose.yml publishing a small range rather than a single port.
EXPOSE 4000 4840 5502 1883

ENV NODE_ENV=production
ENV FG_CONTROL_PLANE_PORT=4000

# Non-root: nothing here needs root privileges - every published port is
# >1024 (no privileged-port bind needed, even for the protocol
# simulators), and the only filesystem write is data/. su-exec drops from
# root to this user in docker-entrypoint.sh, after that script has fixed up
# /app/data's ownership at container start - a named volume mounted over
# data/ can carry root ownership left over from an earlier root-run
# container, which a build-time-only chown here would not fix (see that
# script's comment).
#
# A real (non--H) home directory is required, not just cosmetic: node-opcua
# writes its default certificate store to $HOME/.config on first OPC UA
# connect and throws EACCES if that can't be created.
RUN addgroup -S -g 1001 ferrion && \
    adduser -S -D -u 1001 -G ferrion ferrion && \
    chown -R ferrion:ferrion /app /home/ferrion
RUN apk add --no-cache su-exec

COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

# /api/health (control-plane/routes.ts) answers 503 while the bridge
# instance sits in "error" - "/" only ever proved that the HTTP listener
# was alive, which said nothing about whether readings were flowing.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --spider "http://127.0.0.1:${FG_CONTROL_PLANE_PORT}/api/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
# node directly, not `npm run`: measured on the running container, npm
# (~63 MB RSS) and the tsx CLI wrapper (~45 MB) sat in the process tree for
# the container's whole life without doing anything after start-up, and npm
# as PID 1 reaps no orphaned grandchildren (each instance's esbuild service
# process) - see docker-compose.yml's `init: true` for that half. The
# `npm_*` environment variables also stop leaking into every child.
CMD ["node", "--import", "tsx", "src/control-plane/server.ts"]
