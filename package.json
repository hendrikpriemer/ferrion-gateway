{
  "name": "ferrion-gateway",
  "version": "0.1.61",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start:control-plane": "tsx src/control-plane/server.ts",
    "fleet": "tsx fleet/launcher.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:data": "tsx scripts/check-data.ts",
    "sbom": "npm sbom --sbom-format=cyclonedx --omit=dev --omit=optional --package-lock-only > sbom.cdx.json",
    "prepare": "node scripts/install-git-hooks.mjs",
    "notice": "tsx scripts/generate-notice.ts",
    "lint": "eslint"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "aedes": "^1.2.0",
    "material-symbols": "0.48.0",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.16.0",
    "node-opcua": "^2.187.9",
    "pino": "^10.4.0",
    "tsx": "^4.20.6",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.12.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
