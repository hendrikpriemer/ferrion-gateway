# Used by fleet.config.json: each instance references an env var name
# (e.g. "apiKeyEnvVar": "FG_KEY_AF2_OPCUA_1") instead of embedding its
# ferrion API key directly, so real keys never end up in a committed file.
# Per-instance configs under config/instances/*.json embed their key directly
# instead (that directory is gitignored except for example.instance.json).
FG_KEY_AF2_OPCUA_1=gw_...
FG_KEY_AF2_MQTT_1=gw_...
FG_KEY_DS1_MODBUS_1=gw_...

# control-plane web UI - binds to 127.0.0.1 only, no auth (local dev tool)
FG_CONTROL_PLANE_PORT=4000

# What interface the control-plane and every simulated protocol server
# bind to - only relevant in Docker, where 127.0.0.1 means "this
# container", not "this machine" (see docker-compose.yml, which sets this
# to 0.0.0.0). Leave unset outside Docker.
# FG_BIND_HOST=0.0.0.0

# Host names the control-plane answers to, on top of localhost/127.0.0.1/
# [::1] - any other Host header gets 421. That is what keeps a DNS-rebinding
# page (loaded from evil.example, whose DNS then points at 127.0.0.1) from
# reaching this unauthenticated API as if it were same-origin. Only needed
# with network_mode: host when you open the UI under the machine's own
# name or LAN address; comma-separated.
# FG_ALLOWED_HOSTS=gateway.plant.local,10.0.0.5

# pino level for the control-plane's instances and as the default for
# fleet/instance configs that set none: fatal, error, warn, info, debug,
# trace. Unknown values fall back to info. Pretty-printing happens only on
# a terminal outside NODE_ENV=production; the container writes JSON lines.
FG_LOG_LEVEL=info

# Where this gateway may search for devices when ferrion asks it to (R07):
# IPv4 networks or single addresses, comma-separated. ferrion can only narrow
# this, never widen it. Not set means no device search at all - the right
# default in a company network that reaches other sites.
# FG_DISCOVERY_ALLOWED_CIDRS=10.20.30.0/24
